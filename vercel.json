{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "crons": [{ "path": "/api/internal/sync", "schedule": "0 2 * * *" }],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(ElevenLabsCrawler|SERankingBacklinksBot|SemrushBot|HeadlessChrome).*"
        }
      ],
      "mitigate": { "action": "deny" }
    }
  ]
}
